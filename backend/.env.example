# Database connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agape_conference?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agape_conference?schema=public"

# Server configuration
NODE_ENV="development"
PORT=3000

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# JWT Secret (if authentication is added later)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Logging
LOG_LEVEL="debug"

# Socket.io
SOCKET_CORS_ORIGIN="http://localhost:5173"

# OpenAI API for AI-powered rooming notes classification and group enhancement
# Set OPENAI_ENABLED=false to completely disable AI features and use keyword-based classification only
OPENAI_ENABLED="true"
OPENAI_API_KEY="your-openai-api-key-here"
OPENAI_MODEL="gpt-4o-mini"  # Options: gpt-4o, gpt-4o-mini, gpt-3.5-turbo
